# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep secrets out, but commit the template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Mixamo conversion intermediates (see scripts/prepare-mocap-model.mjs)
public/models/*.fbx
public/models/coach-anim.glb

# pre-rendered animation frames (intermediate)
.tmp-frames/

# Mixamo rigging intermediate (regenerate with scripts/prepare-coach-model.mjs)
public/models/coach.glb
public/models/coach-mixamo.obj

# build inputs/outputs for the coach model — regenerated by scripts/, never
# fetched at runtime, so there is no reason to ship 10 MB with every deploy
public/models/*.glb
public/models/*.obj

# scratch files from local QA runs — never commit
.qa-*.tmp.js
