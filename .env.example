# ============================================================================
# PRESSURE — environment variables
# Copy this file to `.env.local` and fill in the values. See SETUP.md for a
# full step-by-step. The app runs without these (auth + AI degrade gracefully).
# ============================================================================

# --- Supabase (auth + database) ---
# Project Settings → API → Project URL and the "anon / public" (or publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Service-role ("secret") key — Project Settings → API. Bypasses every row-level
# security rule, so it is SERVER ONLY: never prefix it with NEXT_PUBLIC_ and never
# commit it. The admin panel needs it to list, re-plan and ban accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Show the "Continue with Google" button. Set to "true" ONLY after you enable the
# Google provider in Supabase (needs a Google Cloud OAuth client). Empty = hidden.
NEXT_PUBLIC_GOOGLE_ENABLED=

# --- Anthropic Claude (AI analysis + roadmap) ---
# https://console.anthropic.com → API keys. Server-only, never exposed.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# Optional: override the model (defaults to a current Claude model in code).
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (billing) ---
# Leave all of these empty and billing stays switched off: the pricing page
# keeps working and simply records the choice locally, as it did before.
# Test mode first — the keys start sk_test_ / whsec_ and take fake cards.
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → signing secret.
# Without this the webhook refuses every event, which is the point: it is the
# only proof an event really came from Stripe and not from a stranger.
STRIPE_WEBHOOK_SECRET=

# One price id per tier per cadence (Products → your product → pricing).
STRIPE_PRICE_BUDGET_MONTHLY=
STRIPE_PRICE_BUDGET_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=

# --- Admin panel ---
# /admin is guarded by one fixed login name and one password — no user account
# is involved. Changing either value instantly signs out every admin session.
# ADMIN_USER is optional and defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=
