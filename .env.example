# ============================================================================
# PRESSURE — environment variables
# Copy this file to `.env.local` and fill in the values. See SETUP.md for a
# full step-by-step. The app runs without these (auth + AI degrade gracefully).
# ============================================================================

# --- Supabase (auth + database) ---
# Project Settings → API → Project URL and the "anon / public" (or publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Service-role ("secret") key — Project Settings → API. Bypasses every row-level
# security rule, so it is SERVER ONLY: never prefix it with NEXT_PUBLIC_ and never
# commit it. The admin panel needs it to list, re-plan and ban accounts.
SUPABASE_SERVICE_ROLE_KEY=


# --- Anthropic Claude (AI analysis + roadmap) ---
# https://console.anthropic.com → API keys. Server-only, never exposed.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# Optional: override the model (defaults to a current Claude model in code).
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Paddle (billing) ---
# Paddle, not Stripe: Stripe does not operate in Uzbekistan. Paddle is also a
# Merchant of Record, so it collects and remits US sales tax and EU/UK VAT.
#
# Leave these empty and billing stays switched off: the pricing page keeps
# working and simply records the choice locally, as it did before.
PADDLE_API_KEY=
# 'production' switches to live cards. Anything else (or unset) uses sandbox,
# so a half-configured deploy takes test cards rather than real money.
PADDLE_ENV=
# Paddle → Developer tools → Notifications → your destination → secret key.
# Without it the webhook refuses every event, which is the point: it is the
# only proof an event really came from Paddle and not from a stranger.
PADDLE_WEBHOOK_SECRET=

# One price id per tier per cadence (Catalog → Products → your prices).
PADDLE_PRICE_BUDGET_MONTHLY=
PADDLE_PRICE_BUDGET_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_MAX_MONTHLY=
PADDLE_PRICE_MAX_YEARLY=

# --- Admin panel ---
# /admin is guarded by one fixed login name and one password — no user account
# is involved. Changing either value instantly signs out every admin session.
# ADMIN_USER is optional and defaults to "admin".
# Move the panel off /admin. Once set, /admin returns a plain 404 and the
# panel answers only at this path — so scanners sweeping for admin pages find
# nothing to attack. Pick something unguessable, e.g. /rb-9f3a2c-console.
# Unset, everything stays at /admin.
ADMIN_PATH=

ADMIN_USER=admin
ADMIN_PASSWORD=
